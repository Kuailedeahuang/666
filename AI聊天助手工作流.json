        "jsCode": "// 处理接收到的消息\nconst message = $input.first().json;\n\n// 提取用户输入和上下文\nconst userInput = message.text || message.message || '';\nconst context = message.context || {};\nconst userId = message.userId || 'anonymous';\n\n// 返回处理后的数据\nreturn {\n  userId: userId,\n  userInput: userInput.trim(),\n  context: context,\n  timestamp: new Date().toISOString(),\n  sessionId: message.sessionId || `session_${Date.now()}`\n};"
